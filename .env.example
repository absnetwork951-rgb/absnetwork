# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ADMIN_JWT_SECRET: Secret for signing session cookies
ADMIN_JWT_SECRET="abs_network_super_secure_session_key_2026"

# Supabase CMS configuration
# Project URL (safe to expose — prefixes NEXT_PUBLIC_ are public).
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"

# Publishable key — hashed_master_id / publishable form. Safe for the browser.
# Used by public pages for read-only SELECT queries.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_XXXXXXXXXXXXXXXXXXXXXXXX"

# SERVER-ONLY SECRET — NEVER expose under NEXT_PUBLIC_*, never commit a real
# value. Required by server actions for admin CRUD, storage uploads and seeds.
# Obtain it from: Supabase Dashboard > Settings > API > service_role (hidden)
# or from the new "Secrets" management screen.
SUPABASE_SERVICE_ROLE_KEY="YOUR_SERVICE_ROLE_KEY"

# SMTP delivery for the public contact form (NodeMailer) — SERVER-ONLY.
# All values live in the server environment / `.env.local` only; NEVER expose
# under NEXT_PUBLIC_* and never commit real credentials.
# SMTP_PASSWORD is the mailbox password for SMTP_USER (do not commit).
# If SMTP_PASSWORD is empty, email delivery is skipped and contact inquiries
# are saved in the database only (used during local development / testing).
SMTP_HOST="mail.absnetwork.com.pk"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="info@absnetwork.com.pk"
SMTP_PASSWORD=""
# Hardcoded recipient for all contact inquiries (admin notification).
CONTACT_RECEIVER="info@absnetwork.com.pk"
